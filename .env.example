# Local default: http://127.0.0.1:3100; no Steam API key is required for OpenID.
APP_ORIGIN=http://127.0.0.1:3100
HOST=127.0.0.1
PORT=3100
DATABASE_PATH=.data/creeps.sqlite
# For production set APP_ORIGIN to the public HTTPS origin, HOST=0.0.0.0,
# and DATABASE_PATH to a file on a persistent private volume.
# GitHub Pages can redirect to the server app once its address exists:
# CREEPS_APP_URL=https://your-actual-server-domain
