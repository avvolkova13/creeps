{
  "name": "digital-goods-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/server.mjs --dev",
    "build": "next build",
    "start": "node scripts/server.mjs",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "import:catalog": "python3 scripts/import-catalog.py",
    "build:pages": "node scripts/build-pages.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "enrich:catalog": "python3 scripts/enrich_catalog.py"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3"
  }
}
